# MongoDB Atlas connection string. Include the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/yks-takip

# Generate locally: openssl rand -base64 48
NEXTAUTH_SECRET=

# Public origin used for OAuth callbacks and email links.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google emails
ADMIN_EMAILS=admin@example.com
ALLOWED_EMAILS=teacher@example.com

SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional. Leave empty to disable Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
